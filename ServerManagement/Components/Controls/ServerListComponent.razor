@inject NavigationManager NavigationManager

<table class="table table-striped">
    <RepeaterComponent Items="servers">
        <Header>
            <thead>
                <tr>
                    <th>
                        Name
                    </th>
                    <th>
                        City
                    </th>
                    <th>
                        Status
                    </th>
                    <th>
                        People Online
                    </th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
        </Header>        
        <Row Context="server">
            <ServerComponent Server="server"></ServerComponent>
        </Row>
    </RepeaterComponent>
</table>

@code {

    [Parameter]
    public string? CityName { get; set; }

    [Parameter]
    public string SearchFilter { get; set; } = "";

    [Parameter]
    public int AnotherParameter { get; set; }

    private List<Server>? servers;

    private bool searchFilterChanged = false;
    private bool cityNameChanged = false;

    public override Task SetParametersAsync(ParameterView parameters)
    {
        
        if (parameters.TryGetValue<string>("CityName", out var cityName))
        {
            cityNameChanged = (cityName != this.CityName);
        }
        
        if (parameters.TryGetValue<string>("SearchFilter", out var searchFilter))
        {

            searchFilterChanged = (searchFilter != this.SearchFilter);
        }

        return base.SetParametersAsync(parameters);
    }

    protected override void OnParametersSet()
    {
        if (cityNameChanged || searchFilterChanged)
        {
            if (string.IsNullOrWhiteSpace(this.SearchFilter))
            {
                servers = ServersRepository.GetServersByCity(CityName ?? "Toronto");
            }
            else
            {
                servers = ServersRepository.SearchServers(this.SearchFilter);
            }
        }
    }

    private void DeleteServer(int serverId)
    {
        if (serverId > 0)
        {
            ServersRepository.DeleteServer(serverId);
            NavigationManager.NavigateTo("/servers", true);
        }
    }

}